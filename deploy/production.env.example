# URL pública final. Con dominio y HTTPS conserva true en COOKIE_SECURE.
DOMAIN=ali-nexo.com
WWW_DOMAIN=www.ali-nexo.com
FRONTEND_URL=https://ali-nexo.com
VITE_API_URL=/api

POSTGRES_USER=marketplace
POSTGRES_PASSWORD=replace_with_a_long_database_password
POSTGRES_DB=marketplace

JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=true

# Datos que verá el cliente al solicitar el pago. No se publican en Git.
TRANSFER_BANK_NAME=
TRANSFER_ACCOUNT_HOLDER=
TRANSFER_ACCOUNT_NUMBER=
TRANSFER_CLABE=
TRANSFER_INSTRUCTIONS=
